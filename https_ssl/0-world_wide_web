#!/usr/bin/env bash
# Displays information about subdomains of a domain.
# shellcheck disable=SC2086

display_info() {
    dig "$2.$1" | awk -v sub_domain="$2" '/ANSWER SECTION:/ {getline; print "The subdomain " sub_domain " is a " $4 " record and points to " $5}'
}

if [ -n "$2" ]; then
    display_info "$1" "$2"
else
    for sub in www lb-01 web-01 web-02; do
        display_info "$1" "$sub"
    done
fi
